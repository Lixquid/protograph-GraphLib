/// Reflects a quaternion along a normal, preserving the roll.
module Reflect_FloatQ

in FloatQ: floatQ
in Normal: float3

out this: floatQ

use Math/FromDirectionRoll

where {
    _up = GetUp();
    _dir = FloatQ * _up;
    _roll = FloatQ->EulerAngles_floatQ->unpack.Z;

    FromDirectionRoll(
        _dir->Reflect_Float3(Normal),
        _roll
    )
}
